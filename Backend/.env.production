# Production Environment Variables
# Copy this file to .env and customize the values for production

# API Server Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Gradio UI Configuration  
GRADIO_HOST=0.0.0.0
GRADIO_PORT=7860

# Frontend URL for CORS (comma-separated for multiple origins)
FRONTEND_URL=https://destinyengine.xyz,https://www.destinyengine.xyz

# Ollama Configuration (for RAG)
OLLAMA_BASE_URL=http://localhost:11434

# Environment
ENVIRONMENT=production
